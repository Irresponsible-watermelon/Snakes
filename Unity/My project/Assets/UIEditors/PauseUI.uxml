        <ui:Button text="Close" usage-hints="MaskContainer" double-click-selects-word="false" name="CloseButton" class="Dyslexic-Button" style="height: 35px; width: 70px; opacity: 0.9; border-bottom-right-radius: 5px; border-top-right-radius: 5px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; scale: 2 2; translate: 50px 50px; transform-origin: left top; white-space: pre; background-color: rgba(48, 48, 48, 0.573); border-left-color: rgba(48, 48, 48, 0); border-right-color: rgba(48, 48, 48, 0); border-top-color: rgba(48, 48, 48, 0); border-bottom-color: rgba(48, 48, 48, 0); -unity-font-definition: url(&quot;project://database/Assets/Fonts/OpenDyslexic-Bold.otf?fileID=12800000&amp;guid=bf06dc51a47c6ac44ae3baa461b87afc&amp;type=3#OpenDyslexic-Bold&quot;); color: rgb(255, 255, 255); letter-spacing: 0;"/>
        <ui:VisualElement name="CenterButtonContainer" style="flex-grow: 1; align-items: stretch; justify-content: center; align-self: center; align-content: auto; -unity-slice-type: sliced; transform-origin: center; -unity-text-auto-size: none; white-space: normal; -unity-text-align: upper-left;">
