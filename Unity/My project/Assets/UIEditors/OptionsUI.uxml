    <ui:VisualElement name="Area" style="flex-grow: 1; top: auto; left: auto; right: auto; bottom: auto; position: relative; width: 66%; height: 66%; align-self: center; align-content: auto; justify-content: space-around; margin-top: 50px; margin-right: 0; margin-bottom: 50px; margin-left: 0; align-items: auto; border-top-width: 0; border-bottom-width: 0; flex-basis: auto; background-color: rgba(6, 0, 40, 0.847); border-bottom-right-radius: 50px; border-top-right-radius: 50px; border-top-left-radius: 50px; border-bottom-left-radius: 50px;">
