<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/USS.uss?fileID=7433441132597879392&amp;guid=7e8ea6bd70b867240a49f6b948593e41&amp;type=3#USS"/>
    <ui:VisualElement name="Area" style="flex-grow: 1; top: auto; left: auto; right: auto; bottom: auto; position: relative; width: 66%; height: 66%; align-self: center; align-content: auto; justify-content: space-around; margin-top: 50px; margin-right: 0; margin-bottom: 50px; margin-left: 0; align-items: auto; border-top-width: 0; border-bottom-width: 0; flex-basis: auto; background-color: rgba(6, 0, 40, 0.847); border-bottom-right-radius: 50px; border-top-right-radius: 50px; border-top-left-radius: 50px; border-bottom-left-radius: 50px;">
        <ui:Label text="Options" name="Label" class="Dyslexic-Button" style="align-items: center; align-self: center; align-content: flex-end; top: 100px; margin-bottom: 52px;"/>
        <ui:Button text="" name="CloseButton" icon-image="project://database/Assets/textures/cross.png?fileID=2800000&amp;guid=42f296eb66285ec438aa1ed2387afee0&amp;type=3#cross" selectable="false" style="margin-top: -75px; margin-right: 20px; background-color: rgba(255, 255, 255, 0); border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; aspect-ratio: 1; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; height: 83px; width: 83px; top: 0;"/>
        <ui:ScrollView vertical-scroller-visibility="Auto" name="ScrollView" style="align-self: center; flex-grow: 0; opacity: 0.95; width: 100%; height: 100%; top: 5%;">
            <ui:SliderInt label="Difficulty" value="42" high-value="10" name="DifficultySliderInt" show-input-field="true" fill="false" class="dark_input" style="justify-content: flex-start; align-content: center; max-width: none; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/OpenDyslexic-Regular.otf?fileID=12800000&amp;guid=176522171586fd449843813c518ea2de&amp;type=3#OpenDyslexic-Regular&quot;); transform-origin: center; white-space: normal; -unity-text-align: middle-center; text-overflow: clip; align-self: center; min-width: 550px;"/>
            <ui:SliderInt label="Zoom" value="10" high-value="40" name="ZoomSliderInt" show-input-field="false" fill="false" low-value="5" style="justify-content: flex-start; align-content: center; max-width: none; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/OpenDyslexic-Regular.otf?fileID=12800000&amp;guid=176522171586fd449843813c518ea2de&amp;type=3#OpenDyslexic-Regular&quot;); transform-origin: center; white-space: normal; -unity-text-align: middle-center; text-overflow: clip; align-self: center; min-width: 550px;"/>
            <ui:SliderInt label="Grid Size" value="12" high-value="72" name="GridSliderInt" show-input-field="true" fill="false" low-value="6" class="dark_input" style="justify-content: flex-start; align-content: center; max-width: none; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/OpenDyslexic-Regular.otf?fileID=12800000&amp;guid=176522171586fd449843813c518ea2de&amp;type=3#OpenDyslexic-Regular&quot;); transform-origin: center; white-space: normal; -unity-text-align: middle-center; text-overflow: clip; align-self: center; min-width: 550px;"/>
        </ui:ScrollView>
        <ui:Button text="Apply Settings" name="ApplyButton" class="Dyslexic-Button" style="align-self: flex-end; justify-content: flex-start; align-items: auto; align-content: auto; margin-bottom: 50px; margin-right: 140px; border-bottom-right-radius: 5px; border-top-right-radius: 5px; border-top-left-radius: 5px; border-bottom-left-radius: 5px;"/>
    </ui:VisualElement>
    <ui:HelpBox text="Invalid Grid Size - New grid size must not leave snake outside of grid" message-type="Error" button-text="Ok" picking-mode="Position" enabled="false" name="GridAlert" class="Dyslexic-Button" style="overflow: visible; visibility: hidden; -unity-font-definition: url(&quot;project://database/Assets/Fonts/OpenDyslexic-Bold.otf?fileID=12800000&amp;guid=bf06dc51a47c6ac44ae3baa461b87afc&amp;type=3#OpenDyslexic-Bold&quot;); position: absolute; top: 40%; left: 25%; right: 25%; font-size: 24px; -unity-text-align: middle-center; text-overflow: clip; white-space: normal; padding-top: 8px; padding-bottom: 8px; scale: 1 1; height: auto; border-top-left-radius: 25px; border-top-right-radius: 25px; border-bottom-right-radius: 25px; border-bottom-left-radius: 25px; opacity: 1;"/>
</ui:UXML>
